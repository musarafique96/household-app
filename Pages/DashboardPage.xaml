<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HouseholdApp.Pages.DashboardPage"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Label Text="This month" Style="{StaticResource Heading}" />

            <Frame Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="SummaryLabel" FontSize="18" FontAttributes="Bold" />
                    <Label x:Name="RemainingLabel" TextColor="#6B6880" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="By category" FontAttributes="Bold" />
            <VerticalStackLayout x:Name="CategoryStack" Spacing="12">
                <VerticalStackLayout.Resources>
                    <DataTemplate x:Key="CategoryTemplate">
                        <Frame Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding Text}" TextColor="#6B6880" FontSize="13" />
                                </Grid>
                                <ProgressBar Progress="{Binding Progress}" ProgressColor="{Binding BarColor}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </VerticalStackLayout.Resources>
            </VerticalStackLayout>

            <Label Text="Where to save or cut" FontAttributes="Bold" />
            <Frame Style="{StaticResource Card}">
                <Label x:Name="TipsLabel" LineBreakMode="WordWrap" />
            </Frame>

            <Label Text="Last 6 months" FontAttributes="Bold" />
            <VerticalStackLayout x:Name="TrendStack" Spacing="8" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
