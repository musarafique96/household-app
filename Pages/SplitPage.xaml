<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HouseholdApp.Pages.SplitPage"
             Title="Split">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Label Text="Split and Qattah" Style="{StaticResource Heading}" />
            <Label x:Name="StatusLabel" TextColor="#6B6880" />

            <Frame Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Add a shared expense" FontAttributes="Bold" />
                    <Label Text="Split equally among everyone with an account." TextColor="#6B6880" FontSize="13" />
                    <Entry x:Name="SharedTitle" Placeholder="What was it for?" />
                    <Entry x:Name="SharedAmount" Placeholder="Amount" Keyboard="Numeric" />
                    <Picker x:Name="PayerPicker" Title="Who paid?"
                            ItemDisplayBinding="{Binding DisplayName}" />
                    <Button Text="Add" Clicked="OnAddSharedClicked"
                            Style="{StaticResource PrimaryButton}" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Who owes whom" FontAttributes="Bold" />
            <Frame Style="{StaticResource Card}">
                <Label x:Name="BalanceLabel" LineBreakMode="WordWrap" />
            </Frame>

            <Label Text="Recent shared expenses" FontAttributes="Bold" />
            <Frame Style="{StaticResource Card}">
                <Label x:Name="ExpenseLabel" LineBreakMode="WordWrap" />
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
