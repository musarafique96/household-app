rules_version = '2';

// Gharbaar security rules. People are identified by their account ID (uid), which cannot be faked.
// - Any signed-in account can create a family and becomes its first admin.
// - Admins invite people by Gmail, phone number or username. The invite appears only for that person.
// - Family members read and write shared family data under "familyData".
// - Each account's own data and profile (no family) lives under "personal" and only that account can read it.
// - Phone numbers are reserved so that each number belongs to one account.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/personal/$(me())/profile).data;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/personal/$(me())/profile);
    }

    // True if an invite key belongs to the signed-in person (by Gmail, phone number or username).
    function inviteIsMine(key) {
      return signedIn() && (
        (request.auth.token.email != null && key == 'gmail:' + request.auth.token.email.lower())
        || (hasProfile() && myProfile().username != '' && key == 'user:' + myProfile().username)
        || (hasProfile() && myProfile().phone != '' && key == 'phone:' + myProfile().phone)
      );
    }

    function inFamily(fid) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(fid)/members/$(me()));
    }

    function isFamilyAdmin(fid) {
      return inFamily(fid)
        && get(/databases/$(database)/documents/families/$(fid)/members/$(me())).data.role == 'admin';
    }

    // A family. The creator is recorded so they can add themselves as the first admin.
    match /families/{fid} {
      allow create: if signedIn() && request.resource.data.createdBy == me();
      allow read: if inFamily(fid);
      allow update, delete: if isFamilyAdmin(fid);

      // Members, keyed by account ID.
      // Admins add or remove people. The creator adds themselves as admin once.
      // A person who was invited can add themselves when they accept.
      match /members/{uid} {
        allow read: if inFamily(fid) || me() == uid;
        allow create: if isFamilyAdmin(fid)
          || (me() == uid
              && request.resource.data.role == 'member'
              && hasInvite(fid))
          || (me() == uid
              && request.resource.data.role == 'admin'
              && get(/databases/$(database)/documents/families/$(fid)).data.createdBy == me());
        allow update: if isFamilyAdmin(fid);
        allow delete: if isFamilyAdmin(fid) || me() == uid;
      }
    }

    // Is there an invite to this family for the signed-in person?
    function hasInvite(fid) {
      return (signedIn() && request.auth.token.email != null
              && exists(/databases/$(database)/documents/invites/$('gmail:' + request.auth.token.email.lower()))
              && get(/databases/$(database)/documents/invites/$('gmail:' + request.auth.token.email.lower())).data.familyId == fid)
          || (hasProfile() && myProfile().username != ''
              && exists(/databases/$(database)/documents/invites/$('user:' + myProfile().username))
              && get(/databases/$(database)/documents/invites/$('user:' + myProfile().username)).data.familyId == fid)
          || (hasProfile() && myProfile().phone != ''
              && exists(/databases/$(database)/documents/invites/$('phone:' + myProfile().phone))
              && get(/databases/$(database)/documents/invites/$('phone:' + myProfile().phone)).data.familyId == fid);
    }

    // Lets an account find the families it belongs to, by its own ID only.
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && me() == uid;
    }

    // Invites. The key is 'gmail:<address>', 'user:<username>' or 'phone:<number>'.
    match /invites/{key} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['familyId', 'familyName', 'invitedBy', 'createdAt'])
        && isFamilyAdmin(request.resource.data.familyId)
        && request.resource.data.invitedBy == me();
      allow read: if inviteIsMine(key) || (signedIn() && resource.data.invitedBy == me());
      allow delete: if inviteIsMine(key) || (signedIn() && isFamilyAdmin(resource.data.familyId));
      allow update: if false;
    }

    // Shared family data: expenses, budgets, splits, inventory, cooking, and so on.
    match /familyData/{fid}/{document=**} {
      allow read, write: if inFamily(fid);
    }

    // Phone numbers: each number belongs to one account. Only that account can free it.
    match /phones/{phone} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Each account's own data, and its profile (username, phone, Gmail) used to match invites.
    match /personal/{uid}/{document=**} {
      allow read, write: if signedIn() && me() == uid;
    }
  }
}
