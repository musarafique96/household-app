rules_version = '2';

// Gharbaar security rules. People are identified by their account ID (uid), which cannot be faked.
// - Any signed-in account can create a group and becomes its admin.
// - Any member of a group can add a person to it. The person gets a request, and joins only when they accept.
// - Only a group admin can remove a member. A member can leave.
// - Family data lives under "familyData". Each account's own data lives under "personal".
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/personal/$(me())/profile/info);
    }

    function myProfile() {
      return get(/databases/$(database)/documents/personal/$(me())/profile/info).data;
    }

    // True if an invite target belongs to the signed-in person (by Gmail, phone number or username).
    function inviteIsMine(target) {
      return signedIn() && (
        (request.auth.token.email != null && target == 'gmail:' + request.auth.token.email.lower())
        || (hasProfile() && myProfile().username != '' && target == 'user:' + myProfile().username)
        || (hasProfile() && myProfile().phone != '' && target == 'phone:' + myProfile().phone)
      );
    }

    function inFamily(fid) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(fid)/members/$(me()));
    }

    function isFamilyAdmin(fid) {
      return inFamily(fid)
        && get(/databases/$(database)/documents/families/$(fid)/members/$(me())).data.role == 'admin';
    }

    // The signed-in person has a pending request to join this group.
    function hasPendingInvite(fid) {
      return signedIn() && (
        (request.auth.token.email != null
          && exists(/databases/$(database)/documents/invites/$(fid + '|gmail:' + request.auth.token.email.lower()))
          && get(/databases/$(database)/documents/invites/$(fid + '|gmail:' + request.auth.token.email.lower())).data.status == 'pending')
        || (hasProfile() && myProfile().username != ''
          && exists(/databases/$(database)/documents/invites/$(fid + '|user:' + myProfile().username))
          && get(/databases/$(database)/documents/invites/$(fid + '|user:' + myProfile().username)).data.status == 'pending')
        || (hasProfile() && myProfile().phone != ''
          && exists(/databases/$(database)/documents/invites/$(fid + '|phone:' + myProfile().phone))
          && get(/databases/$(database)/documents/invites/$(fid + '|phone:' + myProfile().phone)).data.status == 'pending')
      );
    }

    // A group. The creator is recorded so they can add themselves as the first admin.
    match /families/{fid} {
      allow create: if signedIn() && request.resource.data.createdBy == me();
      allow read: if inFamily(fid);
      // Any member can rename the group.
      allow update: if inFamily(fid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if isFamilyAdmin(fid);

      match /members/{uid} {
        allow read: if inFamily(fid) || me() == uid;
        // Admins can add members directly. A person can join only by accepting a pending request.
        allow create: if isFamilyAdmin(fid)
          || (me() == uid && request.resource.data.role == 'member' && hasPendingInvite(fid))
          || (me() == uid && request.resource.data.role == 'admin'
              && get(/databases/$(database)/documents/families/$(fid)).data.createdBy == me());
        allow update: if isFamilyAdmin(fid);
        // Admins remove members. A member can leave.
        allow delete: if isFamilyAdmin(fid) || me() == uid;
      }
    }

    // Lets an account find the groups it belongs to, by its own ID only.
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && me() == uid;
    }

    // Requests to join a group. The id is "<groupId>|<target>", e.g. "abc|user:musa".
    match /invites/{id} {
      // Any member of the group can send a request.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['familyId', 'familyName', 'invitedBy', 'invitedByName', 'targetKey', 'status', 'createdAt'])
        && inFamily(request.resource.data.familyId)
        && request.resource.data.invitedBy == me()
        && request.resource.data.status == 'pending'
        && id == request.resource.data.familyId + '|' + request.resource.data.targetKey;
      // The person asked can see the request. The sender can see the requests they sent.
      allow read: if signedIn() && (inviteIsMine(resource.data.targetKey) || resource.data.invitedBy == me());
      // The person asked can accept or reject. Only the status can change.
      allow update: if signedIn() && inviteIsMine(resource.data.targetKey)
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if signedIn() && (resource.data.invitedBy == me() || isFamilyAdmin(resource.data.familyId));
    }

    // Shared group data: expenses, budgets, splits, inventory, cooking, and so on.
    match /familyData/{fid}/{document=**} {
      allow read, write: if inFamily(fid);
    }

    // Phone numbers: each number belongs to one account. Only that account can free it.
    match /phones/{phone} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Usernames and Gmail addresses: each belongs to one account. Used to check that a person exists.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update: if signedIn() && resource.data.uid == me() && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }
    match /gmails/{addr} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update: if signedIn() && resource.data.uid == me() && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Each account's own data, and its profile (username, phone, Gmail) used to match requests.
    match /personal/{uid}/{document=**} {
      allow read, write: if signedIn() && me() == uid;
    }
  }
}
