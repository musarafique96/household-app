rules_version = '2';

// Only signed-in Google accounts listed here can read or write any data.
// Add each family member's Gmail address to the list below.
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'FAMILY_MEMBER_1@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if isFamily();
    }
  }
}
