rules_version = '2';

// Gharbaar security rules.
// - Anyone signed in with Google can create a family.
// - Family members read and write the family's data under "familyData".
// - Each person's own data (no family) lives under "personal" and only they can read it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function me() {
      return request.auth.token.email;
    }

    function inFamily(fid) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(fid)/members/$(me()));
    }

    function isFamilyAdmin(fid) {
      return inFamily(fid)
        && get(/databases/$(database)/documents/families/$(fid)/members/$(me())).data.role == 'admin';
    }

    // A family. The creator is recorded so they can add themselves as the first admin.
    match /families/{fid} {
      allow create: if signedIn() && request.resource.data.createdBy == me();
      allow read: if inFamily(fid);
      allow update, delete: if isFamilyAdmin(fid);

      // Members of a family. Admins add or remove people. The creator adds themselves as admin once.
      match /members/{email} {
        allow read: if inFamily(fid) || me() == email;
        allow create: if isFamilyAdmin(fid)
          || (me() == email
              && email == me()
              && request.resource.data.role == 'admin'
              && get(/databases/$(database)/documents/families/$(fid)).data.createdBy == me());
        allow update, delete: if isFamilyAdmin(fid);
      }
    }

    // Lets a person find the families they belong to, by their own email only.
    match /{path=**}/members/{email} {
      allow read: if signedIn() && me() == email;
    }

    // Shared family data: expenses, budgets, splits, inventory, cooking, and so on.
    match /familyData/{fid}/{document=**} {
      allow read, write: if inFamily(fid);
    }

    // Personal data for people who are not in a family.
    match /personal/{email}/{document=**} {
      allow read, write: if signedIn() && me() == email;
    }
  }
}
